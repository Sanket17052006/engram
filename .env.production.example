# Copy this file to .env.production on the server and fill secrets there.
APP_DOMAIN=engram.example.com
FALKORDB_PASSWORD=replace-with-a-long-random-hex-secret
FALKORDB_IMAGE=falkordb/falkordb-server:latest

GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ID=your-app-id
GITHUB_APP_CLIENT_ID=your-client-id
GITHUB_APP_CLIENT_SECRET=your-client-secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
SESSION_SECRET=replace-with-openssl-rand-hex-32
ENGRAM_INTERNAL_API_KEY=replace-with-a-second-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
