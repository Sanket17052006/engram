# Optional: set this to a FalkorDB Redis-protocol URL to use your real graph.
FALKORDB_URL=redis://localhost:6379
FALKORDB_GRAPH=engram_company

# Optional: authenticated GitHub REST API access increases the public API rate limit.
GITHUB_TOKEN=github_pat_your_read_only_token

# GitHub App (recommended: create an app with read-only repository permissions)
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.your-client-id
GITHUB_APP_CLIENT_SECRET=your-client-secret
# Paste your downloaded PEM with newline characters escaped as \\n.
GITHUB_APP_PRIVATE_KEY=replace-with-your-github-app-private-key
# Use the exact origin where Next.js is running (3100 in the local demo below).
# Set the GitHub App callback URL to http://localhost:3100/api/github/auth/callback
# Set the GitHub App setup URL to http://localhost:3100/api/github/callback
SESSION_SECRET=generate-a-random-secret-with-openssl-rand-hex-32

# Private Python core. Generate a random shared secret; do not expose this port publicly.
ENGRAM_CORE_URL=http://127.0.0.1:8000
ENGRAM_INTERNAL_API_KEY=generate-a-second-random-secret
ENGRAM_MODEL_PROVIDER=ollama
ENGRAM_MODEL=qwen2.5-coder:1.5b
ENGRAM_CODEBASE_PATH=/absolute/path/to/a/local/repository-checkout
# Local code-repair worktrees and optional existing checkouts. Keep the worktree
# directory outside the source repository so generated branches/commits are isolated.
ENGRAM_REPAIR_ROOT=/absolute/path/to/engram-repair-data
OPENLIBRARY_REPAIR_CHECKOUT=/absolute/path/to/openlibrary-checkout
# Optional JSON map for repositories with an existing local checkout.
ENGRAM_REPAIR_CHECKOUTS={}
# Repair and repository test execution are disabled unless explicitly enabled
# for trusted local repositories. This is not a sandbox for untrusted code.
ENGRAM_REPAIR_ALLOWED_REPOSITORIES=
ENGRAM_ALLOW_UNSANDBOXED_REPAIR_TESTS=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
